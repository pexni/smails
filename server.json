{
	"$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
	"name": "io.github.pexni/smails",
	"title": "smails",
	"description": "Disposable email inboxes for AI agents: create an address, wait for the verification email.",
	"websiteUrl": "https://smails.dev",
	"repository": {
		"url": "https://github.com/pexni/smails",
		"source": "github",
		"subfolder": "cli"
	},
	"version": "0.1.0",
	"packages": [
		{
			"registryType": "npm",
			"registryBaseUrl": "https://registry.npmjs.org",
			"identifier": "@smails/cli",
			"version": "0.1.0",
			"transport": {
				"type": "stdio"
			},
			"packageArguments": [
				{
					"type": "positional",
					"value": "mcp"
				}
			]
		}
	],
	"remotes": [
		{
			"type": "streamable-http",
			"url": "https://smails.dev/mcp"
		}
	]
}
