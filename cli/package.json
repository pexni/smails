{
	"name": "@smails/cli",
	"version": "0.1.0",
	"description": "Disposable email for AI agents — sign in once, then create inboxes and wait for verification codes from the CLI or any MCP client.",
	"keywords": [
		"agent",
		"ai",
		"cli",
		"disposable-email",
		"email",
		"inbox",
		"mcp",
		"mcp-server",
		"model-context-protocol",
		"temporary-email",
		"throwaway-email"
	],
	"homepage": "https://smails.dev",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pexni/smails.git",
		"directory": "cli"
	},
	"bin": {
		"smails": "dist/index.js"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc -p tsconfig.json",
		"test": "vitest run"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"tsdown": "^0.23.5",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	},
	"engines": {
		"node": ">=22.18"
	},
	"mcpName": "io.github.pexni/smails"
}
