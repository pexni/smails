{
	"name": "smails-worker",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite build && vite preview --port 8793",
		"cf-typegen": "cf workers types",
		"typecheck": "pnpm run cf-typegen && tsc -p tsconfig.json",
		"test": "vitest run",
		"postinstall": "pnpm run cf-typegen",
		"migrate": "node d1.mjs migrate",
		"users": "node d1.mjs users",
		"stats": "node d1.mjs stats",
		"ban": "node d1.mjs ban",
		"unban": "node d1.mjs unban",
		"deploy": "pnpm --filter smails-web run build && vite build && pnpm run migrate && cf deploy --prebuilt",
		"deploy:first": "pnpm --filter smails-web run build && vite build && pnpm run migrate && cf deploy --prebuilt --secrets-file .env.production",
		"deploy:dry-run": "pnpm --filter smails-web run build && vite build && cf deploy --prebuilt --dry-run",
		"rejections": "node d1.mjs rejections"
	},
	"dependencies": {
		"@cfworker/json-schema": "^4.1.6",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"postal-mime": "^4.2.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "2.0.0-beta.v.11",
		"@types/node": "^26.6.6",
		"cf": "1.0.0-beta.27",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.1.0"
	}
}
