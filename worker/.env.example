# 本地开发用的密钥。复制成 .env 后再填；.env 不进 git。
# 首次部署时复制成 .env.production，填上线上的值，用 --secrets-file 带上。

# GitHub OAuth App（只用来确认用户是谁）。本地开发的回调地址：
# http://localhost:8792/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 下面三个是我们自己的签名密钥，随便生成一串长的随机数即可：openssl rand -base64 32
# 逗号分隔可以轮换：最左边的用来签名，其余的只用来验证。
TOKEN_SECRETS=local-dev-token-secret-change-me
SESSION_SECRETS=local-dev-session-secret-change-me
ADDR_SECRET=local-dev-addr-secret-change-me
