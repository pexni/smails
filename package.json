{
	"name": "smails",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "pnpm run \"/^dev:.*/\"",
		"dev:web": "pnpm --filter smails-web run dev",
		"dev:worker": "pnpm --filter smails-worker run dev",
		"build": "pnpm --filter smails-web run build && pnpm --filter smails-worker run build",
		"typecheck": "pnpm -r run typecheck",
		"lint": "oxlint --deny-warnings",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
		"test": "pnpm -r run test"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"oxfmt": "^0.76.0",
		"oxlint": "^1.91.0",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=22.18"
	}
}
